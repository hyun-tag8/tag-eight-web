---
import { company, organizationJsonLd } from '../data/company';
import { langMeta, localePath, type Lang } from '../data/i18n';
import { langsFor } from '../data/cases';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 언어 접두사를 뺀 경로. 예: '/about', '/' */
  path: string;
  /** true 면 robots noindex. 송신 완료 페이지 등 */
  noindex?: boolean;
  /** 손글씨 폰트를 로드한다. CJK 라 무거우므로 쓰는 페이지에서만 켠다 */
  handwriting?: boolean;
  /** OG 이미지 경로. 기사면 그 기사의 cover 를 넘긴다. 없으면 사이트 공통 /og.jpg */
  image?: string;
}

const { lang, title, description, path, noindex = false, handwriting = false, image } = Astro.props;

/* ⚠ OG 이미지는 절대 URL 이어야 SNS 가 읽는다. 상대 경로면 카드가 비어 보인다.
   기사는 cover 를, 그 외 페이지는 공통 /og.jpg 를 쓴다. (2026-08-28) */
const ogImage = new URL(image ?? '/og.jpg', Astro.site ?? company.url).toString();

/* 손글씨 폰트는 언어마다 다르다 — 하나로 3개 문자권을 못 덮는다.
   ja  Klee One       연필로 쓴 교과서체. 격식을 잃지 않는다
   ko  Nanum Pen      한글 손글씨 중 가장 판독이 좋다
   tw  LXGW WenKai TC 해서(楷書) 계열. Klee One 과 인상이 맞는다 */
const HAND: Record<Lang, string> = {
  ja: 'Klee+One:wght@400;600',
  ko: 'Nanum+Pen+Script',
  'zh-tw': 'LXGW+WenKai+TC:wght@400;700',
};

/* ⚠ canonical/hreflang 은 말미 슬래시로 통일한다. (2026-09-04 실측)
   Cloudflare Pages 는 비슬래시 URL 을 308 로 슬래시판에 돌리고, 사이트맵도 슬래시판을 싣는다.
   비슬래시를 가리키면 신호가 갈라져 GSC 「代替ページ」判定이 난다. */
const abs = (l: Lang, p: string) => {
  const u = new URL(localePath(l, p), Astro.site ?? company.url);
  if (!u.pathname.endsWith('/')) u.pathname += '/';
  return u.toString();
};
const canonical = abs(lang, path);

// hreflang — 그 경로가 실제로 존재하는 언어만.
// 없는 페이지를 가리키면 색인 오류(alternate page with 404)가 난다.
const available = langsFor(path);
const alternates = available.map((l) => ({
  hreflang: langMeta[l].htmlLang,
  href: abs(l, path),
}));

// CJK 명조는 활성 언어 것만 불러온다. 3개를 다 불러오면 수 MB가 된다.
const cjkFont: Record<Lang, string> = {
  ja: 'Noto+Sans+JP:wght@200;300;400;500',
  ko: 'Noto+Sans+KR:wght@200;300;400;500',
  'zh-tw': 'Noto+Sans+TC:wght@200;300;400;500',
};
const cjkFamily: Record<Lang, string> = {
  ja: "'Noto Sans JP'",
  ko: "'Noto Sans KR'",
  'zh-tw': "'Noto Sans TC'",
};

const fontHref =
  'https://fonts.googleapis.com/css2' +
  '?family=Inter:wght@200;300;400;500' +
  `&family=${cjkFont[lang]}` +
  '&display=swap';

const jsonLd = JSON.stringify(organizationJsonLd());
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
{noindex && <meta name="robots" content="noindex,follow" />}
{handwriting && (
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${HAND[lang]}&display=swap`} />
)}
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{available.includes('ja') && (
  <link
    rel="alternate"
    hreflang="x-default"
    href={abs('ja', path)}
  />
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={company.legalNameEn} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={langMeta[lang].htmlLang.replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />

{/* OG 이미지 — 링크를 공유했을 때 뜨는 카드. 절대 URL 이어야 한다 */}
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontHref} />

<style is:inline set:html={`:root { --cjk: ${cjkFamily[lang]}, system-ui, sans-serif; }`}></style>

<script type="application/ld+json" is:inline set:html={jsonLd} />

{/* ── Cloudflare Web Analytics ──────────────────────────
    쿠키를 쓰지 않고 개인을 추적하지 않는다. 그래서 동의 배너가 필요 없다.
    (GA4 였다면 일본 개인정보보호법·EU GDPR 대응으로 배너가 필요했다)

    ⚠ 호스트명 단위로 집계된다. 현재 등록된 것은 tag-eight-web.pages.dev 다.
      tag-8.com 을 연결한 뒤에는 Cloudflare 대시보드에서 그 호스트도 추가해야
      데이터가 끊기지 않는다. 토큰은 그대로 쓰면 된다.

    ⚠ 이 도구는 유입 경로(referrer)까지만 보여주고 검색어는 보여주지 않는다.
      「어떤 키워드로 찾아왔는가」는 Google Search Console 이 필요하다.

    토큰은 HTML 에 그대로 실리는 공개값이라 저장소에 두어도 된다. */}
<script
  type="module"
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon='{"token": "90311ead309f471f9742054fbfb8b1cf"}'
  is:inline
></script>
