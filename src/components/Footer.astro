---
/**
 * 푸터 — 한 줄로 닫는다.
 * 연락처·주소는 바로 위 클로징의 CONTACT 링크와 CONTACT 페이지에 있으므로
 * 여기서 반복하지 않는다. 기계가 읽는 정보는 JSON-LD(Head)에 그대로 남는다.
 */
import { company } from '../data/company';
import { t, langMeta, localePath, type Lang } from '../data/i18n';
import { langsFor } from '../data/cases';
import Logo from './Logo.astro';

interface Props { lang: Lang; path: string; /** 이 페이지가 존재하는 언어. 기사 경로에서 넘긴다 */ langs?: Lang[] }
const { lang, path, langs } = Astro.props;
const year = new Date().getFullYear();

// 그 언어에 이 페이지가 없으면 링크하지 않는다.
// (zh-tw 케이스 상세는 번역 전이라 아직 생성되지 않는다)
const available = langs ?? langsFor(path);
---
<footer class="site-footer invert">
  <div class="wrap site-footer__row">
    <p class="site-footer__copy">
      {/* 마크만 사용한다. 락업은 「TAG EIGHT LLC.」 가 저작권 표기와 겹친다 */}
      <a class="site-footer__mark" href={localePath(lang, '/')} aria-label={company.legalNameEn}>
        <Logo variant="mark" height="0.9rem" />
      </a>
      <span>© {year} {company.legalNameEn}</span>
      <a class="site-footer__legal" href={localePath(lang, '/privacy')}>{t[lang].privacy.head}</a>
    </p>
    <nav class="lang-switch" aria-label="Language">
      {available.map((l) => (
        <a href={localePath(l, path)} hreflang={langMeta[l].htmlLang} aria-current={l === lang ? 'true' : undefined}>
          {langMeta[l].label}
        </a>
      ))}
    </nav>
  </div>
</footer>
