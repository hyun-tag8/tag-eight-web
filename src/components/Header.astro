---
import { t, localePath, type Lang } from '../data/i18n';
import Logo from './Logo.astro';

interface Props { lang: Lang; path: string; overHero?: boolean }
const { lang, path, overHero = false } = Astro.props;
const d = t[lang];

const items = [
  { href: '/about', label: d.nav.about },
  { href: '/capabilities', label: d.nav.service },
  { href: '/works', label: d.nav.works },
  { href: '/insight', label: d.nav.insight },
  { href: '/company', label: d.nav.company },
  { href: '/contact', label: d.nav.contact },
];
---
<header class:list={['site-header', !overHero && 'site-header--solid']} id="siteHeader">
  <div class="wrap site-header__in">
    <a class="brand" href={localePath(lang, '/')} aria-label={d.siteTitle}>
      <Logo variant="mark" height="1rem" />
    </a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="navlist">Menu</button>
    <ul class="nav" id="navlist">
      {items.map((i) => (
        <li>
          <a href={localePath(lang, i.href)} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const h = document.getElementById('siteHeader');
  const btn = h?.querySelector('.nav__toggle');
  if (h && btn) {
    btn.addEventListener('click', () => {
      const open = h.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Close' : 'Menu';
    });
  }
</script>
