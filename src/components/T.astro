---
/**
 * CJK 본문 렌더러.
 * 문절 경계에만 <wbr> 를 넣어 어절 중간에서 줄이 끊기지 않게 한다.
 * 래퍼 요소를 만들지 않으므로 기존 스타일에 영향이 없다.
 *
 *   <p class="lead"><T text={d.philosophy.vision.body} lang={lang} /></p>
 */
import { wbr } from '../lib/wbr';
import type { Lang } from '../data/i18n';

interface Props { text: string; lang: Lang }
const { text, lang } = Astro.props;
---
<Fragment set:html={wbr(text, lang)} />
