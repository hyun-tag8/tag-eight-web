---
/**
 * 오피스 지도.
 *
 * CARTO Dark(OpenStreetMap 기반) 타일 + Leaflet.
 * Google Maps 를 쓰지 않는 이유 — 다크 스타일로 바꾸려면 CSS 필터를 씌워야 하는데,
 * Google Maps 이용약관상 스타일 변형은 제한이 있다. CARTO 는 다크 타일을 정식 제공하고
 * 저작권 표기만 하면 무료다.
 *
 * 좌표는 src/data/office.ts 에 있다 — 「Google マップで見る」 링크와 같은 값을 봐야 한다.
 * 그 링크 자체는 CONTACT 의 연락처 블록(주소 아래)에서 렌더한다.
 */
import { OFFICE } from '../data/office';

const LAT = OFFICE.lat;
const LNG = OFFICE.lng;
const ZOOM = OFFICE.zoom;

interface Props { label?: string }
const { label } = Astro.props;
---
<div class="omap">
  <div
    class="omap__canvas"
    id="omap"
    data-lat={LAT}
    data-lng={LNG}
    data-zoom={ZOOM}
    data-label={label}
    role="img"
    aria-label={label}
  ></div>
</div>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<script>
  // 지도는 페이지에서 가장 무거운 요소다. 화면에 들어올 때 로드한다.
  const el = document.getElementById('omap');
  if (el) {
    const boot = async () => {
      const L = (await import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js')) as any;
      const lat = Number(el.dataset.lat);
      const lng = Number(el.dataset.lng);
      // 핀이 화면 정중앙이면 우측 폼 카드에 가린다.
      // 넓은 화면에서는 중심을 동쪽으로 밀어 핀을 좌측 본문 옆에 오게 한다.
      // 넓은 화면에서는 좌측에 카피, 우측에 폼이 있다.
      // 중심을 북동쪽으로 밀어 핀이 두 덩어리 사이 빈 곳(우하단)에 서게 한다.
      const wide = window.matchMedia('(min-width: 60rem)').matches;
      const dLng = wide ? 0.0010 : 0;   // 동쪽으로 → 핀은 화면 왼쪽으로
      const dLat = wide ? 0.0030 : 0;   // 북쪽으로 → 핀은 화면 아래로
      const map = L.map(el, {
        center: [lat + dLat, lng + dLng],
        zoom: Number(el.dataset.zoom),
        zoomControl: false,
        scrollWheelZoom: false,   // 스크롤로 페이지를 내리다 지도가 확대되는 사고를 막는다
        attributionControl: true,
      });
      /* ⚠ CARTO 무료 베이스맵이 도메인 등록(API 키)을 요구하게 되어 「API KEY REQUIRED」
           워터마크가 박혔다. OpenStreetMap 은 키·계정 불필요. 컬러 타일이므로
           아래 CSS 필터로 사이트의 다크 흑백 톤에 맞춘다. (2026-09-01) */
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);

      // 핀 — 이미지 대신 SVG. 선 굵기가 사이트 괘선과 같다
      const icon = L.divIcon({
        className: 'omap__pin',
        html:
          '<svg viewBox="0 0 24 34" width="28" height="40" fill="none" stroke="#fff" stroke-width="1.6">' +
          '<path d="M12 33C12 33 22 21.5 22 12.5A10 10 0 1 0 2 12.5C2 21.5 12 33 12 33Z" fill="#F37021"/>' +
          '<circle cx="12" cy="12.5" r="3.2"/></svg>',
        iconSize: [24, 34],
        iconAnchor: [12, 34],
      });
      L.marker([lat, lng], { icon, keyboard: false, alt: el.dataset.label ?? '' }).addTo(map);
      map.on('click', () => map.scrollWheelZoom.enable());
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); boot(); }
      }, { rootMargin: '200px' });
      io.observe(el);
    } else {
      boot();
    }
  }
</script>
