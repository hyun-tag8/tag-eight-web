---
import Arrow from '../components/Arrow.astro';
import { company } from '../data/company';
import { t, langMeta, localePath, type Lang } from '../data/i18n';
import OfficeMap from '../components/OfficeMap.astro';
import { GMAPS_URL } from '../data/office';
import { getPosts } from '../lib/insight';
import { DIAG_PREFILL } from '../data/diagnosis';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const f = d.contact.f;

/* 폼 전송처 — Cloudflare Pages Function (functions/api/contact.ts).
   담당자 통지 + 문의자 자동응답 2통을 보낸다.
   ⚠ Cloudflare Pages 에 배포된 뒤에만 동작한다. 로컬 `astro dev` 에서는 404 다. */
const FORM_ACTION = '/api/contact';

/**
 * ⚠ 이 사이트는 SSG(output:'static')다. Astro.url.searchParams 는 **빌드 시점**에
 *   평가되므로 항상 빈 값이고, 방문자가 붙인 ?e= / ?s= 는 여기서 읽을 수 없다.
 *   (이 때문에 전송 실패 안내가 지금까지 한 번도 표시되지 않았다 — 2026-08-26 발견)
 *
 *   따라서 두 가지 모두 아래 <script> 에서 브라우저가 처리한다.
 *     ?e=1|2      전송 실패 안내를 띄운다
 *     ?s=<postId> INSIGHT 기사에서 넘어온 경우 用件·相談内容을 미리 채운다
 *
 *   프리필에 필요한 「기사ID → 用件·제목」 대응표는 빌드 시 만들어 data 속성으로 넘긴다.
 */
const posts = await getPosts(lang);
const PREFILL = Object.fromEntries(
  posts.map((e) => [
    e.data.postId,
    {
      /* 기사의 분류로 用件을 고른다. guide 는 어느 시장인지 알 수 없으므로 비운다.
         subjects 순서: 0 韓国 / 1 台湾 / 2 日本 / 3 採用 / 4 その他 */
      s: e.data.category === 'taiwan' ? f.subjects[1] : e.data.category === 'korea' ? f.subjects[0] : '',
      t: e.data.title,
    },
  ])
);
/* ?s=diagnosis — 現地実測診断 페이지에서 넘어온 문의. 用件은 韓国, 相談内容 첫 줄을 채운다 */
PREFILL['diagnosis'] = { s: f.subjects[0], t: DIAG_PREFILL[lang] };
---
{/* 지도 패널 — 왼쪽에 위치와 연락처, 오른쪽에 폼 카드.
    이전에는 머리 → 오피스 사진 → 연락처 → 폼 순으로 쌓여 3293px(3화면)였다.
    문의하러 온 사람이 스크롤을 세 번 하는 구조였다.
    오피스 사진은 COMPANY 에 있으므로 여기서는 지도로 바꾼다. */}
<section class="ctpanel tone" data-layout="contact-v179">
  <OfficeMap label={company.addressJa} />

  <div class="ctpanel__in">
    <div class="ctpanel__info">
      <p class="label ctpanel__label">{d.contact.eyebrow}</p>
      <p class="ctpanel__kicker">{d.contact.kicker}</p>
      <h1 class="ctpanel__head">
        {d.contact.head.map((l) => <span style="display:block">{l}</span>)}
      </h1>

      <dl class="ctpanel__spec">
        <div class="ctpanel__row">
          <dt>Email</dt>
          <dd><a class="link" href={`mailto:${company.email}`}>{company.email}</a></dd>
        </div>
        <div class="ctpanel__row">
          <dt>Tel</dt>
          <dd>{company.tel}</dd>
        </div>
        {/* 주소는 한 줄로 세운다. 좌우 2열이면 폭이 모자라 「13階」만 다음 줄로 떨어진다 */}
        <div class="ctpanel__row ctpanel__row--wide">
          <dt>Address</dt>
          <dd>
            {company.addressJa}
            {/* 지도 링크는 주소 바로 아래. 지도 위에 띄우면 카피·폼과 자리를 다툰다 */}
            <a class="omap__link link--arw" href={GMAPS_URL} target="_blank" rel="noopener noreferrer">
              <span>{f.mapLink}</span><Arrow variant="chev" cls="link__arw" />
            </a>
          </dd>
        </div>
      </dl>
    </div>

    {/* 폼 카드 — 사이트에서 유일하게 검정 위에 흰 판이 오는 자리.
        여기가 종착점이라는 신호가 된다 */}
    <div class="ctcard">
      <p class="ctcard__label">{d.contact.formLabel}</p>

      <form class="cform" method="POST" action={FORM_ACTION || undefined}>
        <input type="hidden" name="_lang" value={langMeta[lang].htmlLang} />
        {/* 봇 트랩. 사람에게는 보이지 않는다 */}
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="cform__trap" aria-hidden="true" />

        <div class="cform__row">
          <label for="cf-company">{f.company} <span class="cform__req">{f.required}</span></label>
          <input id="cf-company" name="company" type="text" required autocomplete="organization" />
        </div>

        <div class="cform__row">
          <label for="cf-name">{f.name} <span class="cform__req">{f.required}</span></label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" />
        </div>

        <div class="cform__row">
          <label for="cf-email">{f.email} <span class="cform__req">{f.required}</span></label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>

        {/* ⚠ select 는 첫 항목이 자동 선택된다. 빈 플레이스홀더를 앞에 두지 않으면
            아무도 고르지 않은 문의가 전부 「韓国のご相談」으로 접수된다 */}
        <div class="cform__row">
          <label for="cf-subject">{f.subject} <span class="cform__req">{f.required}</span></label>
          <select id="cf-subject" name="subject" required>
            <option value="" disabled selected>{f.subjectPlaceholder}</option>
            {f.subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div class="cform__row">
          <label for="cf-message">{f.message}</label>
          <textarea id="cf-message" name="message" rows="4"></textarea>
        </div>

        {/* 동의 체크박스 — 개인情報保護法 21조. 없으면 공개할 수 없다 */}
        <label class="cform__consent">
          <input type="checkbox" name="consent" value="agree" required />
          <span>
            <a class="link" href={localePath(lang, '/privacy')} target="_blank" rel="noopener">{f.consentLink}</a>{f.consent}
          </span>
        </label>

        {/* 내용은 아래 스크립트가 채운다. SSG 라 빌드 시점에는 쿼리를 알 수 없다 */}
        <p class="cform__err" role="alert" hidden
           data-e1={f.errInput} data-e2={f.errServer}></p>
        <p class="meta cform__note">{f.note}</p>
        {/* ⚠ 봇 차단 — Cloudflare Turnstile. _gotcha(허니팟)를 통과하는 봇을 여기서 막는다.
            Managed 모드라 사람은 대개 아무것도 누르지 않고 통과한다. (2026-09-01) */}
        <div class="cf-turnstile cform__ts" data-sitekey="0x4AAAAAAAEjc0KLvvVj1hxnZ" data-theme="light"></div>

        {/* 박스형 버튼 — 사이트 공통 .btn 문법. 테두리가 있으므로 꺾쇠는 호버 때만 열린다 */}
        <button class="btn cform__btn" type="submit">
          <span>{f.submit}</span><span class="btn__slot"><Arrow variant="chev" cls="btn__arrow" /></span>
        </button>
      </form>
    </div>
  </div>

  {/* 기사ID → 用件·제목 대응표. 스크립트가 ?s= 를 이걸로 푼다 */}
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
<script type="application/json" id="ct-prefill" set:html={JSON.stringify(PREFILL)}></script>
</section>

<script>
  /* SSG 라 쿼리 처리는 전부 브라우저 몫이다. 두 가지를 한다.
       ① ?e=1|2  전송 실패 안내 표시
       ② ?s=<postId>  INSIGHT 기사에서 넘어온 문의를 미리 채운다 */
  const q = new URLSearchParams(location.search);

  const err = document.querySelector('.cform__err') as HTMLElement | null;
  const e = q.get('e');
  if (err && (e === '1' || e === '2')) {
    err.textContent = e === '1' ? (err.dataset.e1 ?? '') : (err.dataset.e2 ?? '');
    err.hidden = false;
  }

  const src = q.get('s');
  const raw = document.getElementById('ct-prefill')?.textContent;
  if (src && raw) {
    try {
      const map = JSON.parse(raw) as Record<string, { s: string; t: string }>;
      const hit = map[src];
      if (hit) {
        const sel = document.getElementById('cf-subject') as HTMLSelectElement | null;
        if (sel && hit.s) sel.value = hit.s;
        const msg = document.getElementById('cf-message') as HTMLTextAreaElement | null;
        // 이미 쓰던 내용이 있으면 덮지 않는다(뒤로가기로 돌아온 경우)
        if (msg && !msg.value) msg.value = hit.t + '\n\n';
      }
    } catch { /* 대응표가 깨져도 폼 자체는 살려 둔다 */ }
  }
</script>
