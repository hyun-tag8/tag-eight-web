---
/**
 * INSIGHT 목록 — 2층 구조.
 *
 *   [1층] 常設(guide)  검색·생성형 엔진에서 들어오는 착지점. 안 변한다.
 *   [2층] 3열 박스      韓国 / 台湾 / お知らせ. 계속 쌓인다.
 *
 * 왜 나누는가 —
 *   날짜순 한 줄로 쌓으면, 검색으로 온 사람이 「NAVERブログとは」를 찾다가
 *   최신 お知らせ 부터 읽게 된다. 착지점과 흐름은 역할이 다르므로 자리도 나눈다.
 *
 * ⚠ 台湾 열은 비어도 지운다. 열이 사라지면 「대만은 안 한다」로 읽히므로
 *   준비중을 띄워서라도 3열을 유지한다.
 */
import Sentences from '../components/Sentences.astro';
import T from '../components/T.astro';
import Arrow from '../components/Arrow.astro';
import NewBadge from '../components/NewBadge.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { t, localePath, type Lang } from '../data/i18n';
import { getGuides, getStream, getLeads, fmtDate, STREAM, CAT_SLUG } from '../lib/insight';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const guides = await getGuides(lang);
const stream = await getStream(lang);
/* 첫 화면의 대형 카드 — 분류마다 최신 1건씩, 좌우로 넘긴다 */
const leads = await getLeads(lang);
/* 대형 카드에 선 글은 아래 3행에서 뺀다 — 같은 화면에 두 번 나오면 목록이 어색해진다 */
const leadIds = new Set(leads.map((l) => l.post.data.postId));
/* ⚠ 그 분류에 글이 한 건뿐이면 3행이 통째로 비어 「準備中」이 뜬다.
     바로 위 카드에 있는데도 「아직 없다」로 읽히므로, 뺀 결과가 0이면 빼지 않는다. (2026-08-27) */
const rows = (c: (typeof STREAM)[number]) => {
  const kept = stream[c].filter((p) => !leadIds.has(p.data.postId));
  return kept.length > 0 ? kept : stream[c];
};
const hasStream = STREAM.some((c) => stream[c].length > 0);
---
{/* ⚠ 다른 하위 페이지(WORKS·COMPANY 등)는 「라벨 + 큰 제목 + 리드문」 3단이지만
    INSIGHT 만 라벨 하나로 끝낸다.
    바로 아래에 검정 대형 카드가 서므로, 머리까지 크면 큰 덩어리가 연달아 두 개가 된다.
    페이지 성격은 아래 「韓国・台湾のメディア施策を、はじめから。」가 이미 말하고 있다. */}
<section class="sec sec--flush page-head page-head--slim">
  <div class="wrap">
    <p class="label">{d.journal.eyebrow}</p>
  </div>
</section>

{/* ── 최신 1건 · 대형 카드 ────────────────────────
    페이지 머리 바로 다음. 「지금 이 회사가 무엇을 보고 있나」가 먼저 오고,
    해설(GUIDE)은 그 뒤에 온다 — 해설이 먼저면 매번 같은 화면이 되어
    「업데이트되는 곳」이라는 신호가 사라진다. */}
<section class="sec sec--lead" data-layout="lead-v193">
  <div class="wrap">
    {leads.length > 0 && (
      <div class="leads" data-n={leads.length}>
        <div class="leads__track">
          {leads.map(({ cat, post }) => (
            <a class="ilead" href={localePath(lang, `/insight/${post.data.postId}`)}
               style={post.data.cover ? `--cover:url(${post.data.cover})` : undefined}
               data-cover={post.data.cover ? '' : undefined}>
              <span class="ilead__meta">
                <span>{d.journal.cat[cat as 'korea' | 'taiwan' | 'notice']}</span>
                <span>{fmtDate(post.data.date)}</span>
              </span>
              <span class="ilead__title"><T text={post.data.title} lang={lang} /></span>
              {post.data.excerpt && (
                <span class="ilead__ex">
                  <T text={post.data.excerpt} lang={lang} /><NewBadge date={post.data.date} />
                </span>
              )}
            </a>
          ))}
        </div>

        {leads.length > 1 && (
          <div class="leads__nav">
            {/* 점 대신 분류명을 쓴다 — 어느 시장 이야기인지가 바로 보이고,
                「3개 시장을 다룬다」가 넘기기 전에도 전해진다 */}
            <div class="leads__tabs">
              {leads.map(({ cat }, i) => (
                <button class="leads__tab" type="button" data-go={i} aria-current={i === 0 ? 'true' : undefined}>
                  {d.journal.cat[cat as 'korea' | 'taiwan' | 'notice']}
                </button>
              ))}
            </div>
            <div class="leads__arrows">
              <button class="leads__arw" type="button" data-dir="-1" aria-label="prev">
                <Arrow dir="left" variant="ring" />
              </button>
              <button class="leads__arw" type="button" data-dir="1" aria-label="next">
                <Arrow dir="right" variant="ring" />
              </button>
            </div>
          </div>
        )}
      </div>
    )}

  </div>
</section>

{/* ── 1층 · 常設 해설 ─────────────────────────────
    검색어 하나 = 페이지 하나. 여기가 유입의 입구다 */}
{guides.length > 0 && (
  <section class="sec" data-layout="guides-v180">
    <div class="wrap">
      {/* ⚠ 여기에 영문 라벨(GUIDE 등)을 두지 않는다.
          페이지 머리에 INSIGHT 가 이미 서 있어 큰 라벨이 두 개가 되고,
          「가이드」라는 말이 초심자용 안내서처럼 읽혀 상대를 아래로 보는 인상이 된다.
          일본어 헤드라인 하나로 성격을 전한다 */}
      <h2 class="h-lg"><T text={d.journal.guideHead} lang={lang} /></h2>
      <p class="secsub"><Sentences text={d.journal.guideSub} lang={lang} /></p>

      <div class="guides">
        {guides.map((p, i) => (
          <a class="guide" href={localePath(lang, `/insight/${p.data.postId}`)}>
            <span class="guide__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="guide__body">
              <span class="guide__title"><T text={p.data.title} lang={lang} /></span>
              {p.data.excerpt && <span class="guide__ex"><T text={p.data.excerpt} lang={lang} /></span>}
            </span>
            <Arrow variant="chev" cls="guide__arw" />
          </a>
        ))}
      </div>
    </div>
  </section>
)}

{/* ── 2층 · 3행 가로 배열 ─────────────────────────
    한 행이 한 시장. 왼쪽에 분류가 고정되고, 오른쪽으로 기사가 흐른다.
    세로 3열이던 것을 가로로 바꾼 이유 —
      · 글이 쌓일수록 열마다 높이가 어긋나 계단처럼 보였다
      · 가로면 글이 늘어도 행 높이가 그대로고, 「계속 쌓이고 있다」가 전해진다

    기사는 분류마다 최신 5건까지. 카드가 아니라 목록으로 세운다 —
    카드는 한 장이 자리를 크게 먹어 한 화면에 1~2건밖에 못 보였다.
    그 이상은 분류명(전체 보기)으로 간다

    ⚠ 섹션 제목(LATEST 등)은 두지 않는다. 각 행이 이미 분류명을 갖고 있어 같은 말을 두 번 하게 된다.
    ⚠ 아래 삼항의 각 분기에는 요소가 하나만 온다 — 분기 안에 주석을 넣으면 컴파일이 깨진다 */}
{/* 글이 한 편도 없으면 라벨만 남아 어색하다. 그럴 때는 준비중 한 줄로 끝낸다.
    ko·zh-TW 는 원고가 일본어보다 늦게 붙으므로 이 상태를 지난다 */}
{!hasStream && guides.length === 0 ? (
  <section class="sec">
    <div class="wrap"><div class="empty">{d.journal.empty}</div></div>
  </section>
) : (
<section class="sec" data-layout="stream-v193">
  <div class="wrap">
    <div class="srows">
      {STREAM.map((c) => (
        <div class="srow">
          {/* 분류명은 그 분류의 전체 목록으로 간다.
              가로 스트립에는 최근 것만 보이므로, 쌓인 글로 가는 길이 여기 하나뿐이다 */}
          <p class="srow__head">
            <a class="srow__link" href={localePath(lang, `/insight/${CAT_SLUG[c]}`)}>
              <span>{d.journal.cat[c]}</span><Arrow variant="chev" cls="srow__arw" />
            </a>
          </p>
          {rows(c).length === 0 ? (
            <p class="srow__empty">{d.journal.catEmpty}</p>
          ) : (
            <div class="slist">
              {rows(c).slice(0, 5).map((p) => (
                <a class="sitem" href={localePath(lang, `/insight/${p.data.postId}`)}>
                  <span class="sitem__date">{fmtDate(p.data.date)}</span>
                  <span class="sitem__title"><T text={p.data.title} lang={lang} /></span>
                  <NewBadge date={p.data.date} />
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
)}

<ClosingCta lang={lang} />

<script>
  /* 대형 카드 전환. 스크롤 스냅이 실제 이동을 담당하고,
     스크립트는 화살표·점과 현재 위치 표시만 맡는다.
     ⚠ 자동 재생은 넣지 않는다 — 읽는 도중에 바뀌면 성가시다. */
  const box = document.querySelector<HTMLElement>('.leads');
  if (box) {
    const track = box.querySelector<HTMLElement>('.leads__track')!;
    const dots = [...box.querySelectorAll<HTMLButtonElement>('.leads__tab')];
    const arws = [...box.querySelectorAll<HTMLButtonElement>('.leads__arw')];
    const n = track.children.length;

    const at = () => Math.round(track.scrollLeft / track.clientWidth);
    const sync = () => {
      const i = at();
      dots.forEach((d, k) => (k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      arws.forEach((a) => {
        const dir = Number(a.dataset.dir);
        a.disabled = dir < 0 ? i <= 0 : i >= n - 1;
      });
    };
    const go = (i: number) => {
      track.scrollTo({ left: Math.max(0, Math.min(n - 1, i)) * track.clientWidth, behavior: 'smooth' });
    };

    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.go))));
    arws.forEach((a) => a.addEventListener('click', () => go(at() + Number(a.dataset.dir))));
    track.addEventListener('scroll', () => { clearTimeout((track as any)._t); (track as any)._t = setTimeout(sync, 90); });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
