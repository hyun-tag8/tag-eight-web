---
import T from '../components/T.astro';
import { company } from '../data/company';
import { t, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t[lang].privacy;
---
<section class="sec sec--flush page-head">
  <div class="wrap">
    <p class="label">{p.eyebrow}</p>
    <h1 class="h-lg" style="margin-top:clamp(1.75rem,4vh,2.5rem)"><T text={p.head} lang={lang} /></h1>
    <p class="lead" style="margin-top:1.5rem"><T text={p.intro} lang={lang} /></p>
  </div>
</section>

<section class="sec">
  <div class="wrap legal">
    {p.sections.map((s, i) => (
      <article class="legal__item">
        <p class="legal__no">{String(i + 1).padStart(2, '0')}</p>
        <div>
          <h2 class="legal__h"><T text={s.h} lang={lang} /></h2>
          {s.body.map((b) => <p class="legal__p"><T text={b} lang={lang} /></p>)}
          {s.list && (
            <ul class="legal__list">
              {s.list.map((li) => <li><T text={li} lang={lang} /></li>)}
            </ul>
          )}
        </div>
      </article>
    ))}

    <p class="legal__rev">{p.revised}</p>
    <p class="meta" style="margin-top:1.25rem">
      {company.legalName}<br />
      {company.addressJa}<br />
      {company.email} / TEL {company.tel}
    </p>
  </div>
</section>
