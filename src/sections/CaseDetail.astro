---
import T from '../components/T.astro';
import { getCases, destOf, type Case } from '../data/cases';
import { t, localePath, type Lang } from '../data/i18n';

interface Props { lang: Lang; item: Case }
const { lang, item } = Astro.props;
const d = t[lang];

const list = getCases(lang);
const i = list.findIndex((c) => c.slug === item.slug);
const prev = i > 0 ? list[i - 1] : list[list.length - 1];
const next = i < list.length - 1 ? list[i + 1] : list[0];
const total = String(list.length).padStart(2, '0');

// 도착 시장의 거리 사진을 배경으로. 그 케이스가 어느 시장을 움직였는지가 사진으로 보인다.
// 표시폭은 항상 100vw. 모바일(390px @2x = 780w)은 -sm(800w) 판이면 충분하다.
const heroImg = {
  kr: { key: 'hero-seoul',  w: 1200, h: 600 },
  jp: { key: 'hero-tokyo',  w: 1200, h: 600 },
  tw: { key: 'hero-taipei', w: 1200, h: 600 },
}[destOf(item.route)];
---
<article>
  <div class="case-hero tone">
    <img
      src={`/img/${heroImg.key}.webp`}
      srcset={`/img/${heroImg.key}-sm.webp 800w, /img/${heroImg.key}.webp ${heroImg.w}w`}
      sizes="100vw"
      width={heroImg.w} height={heroImg.h}
      alt="" fetchpriority="high" decoding="async"
    />
    <div class="case-hero__in"><div class="wrap">
      {/* 카드와 같은 규격 — 번호는 크게 흐리게, 카테고리는 굵게 */}
      <p class="case-hero__meta">
        <span class="num">{item.no}</span>
        <span class="case-hero__cat">{item.category}</span>
        <span class="case-hero__route">　—　{item.route}</span>
      </p>
      <h1 class="case-hero__title"><T text={item.title} lang={lang} /></h1>
    </div></div>
  </div>

  <section class="sec sec--flush" style="padding-top:clamp(3.5rem,10vh,6rem)">
    <div class="wrap split" style="align-items:start">
      <div><p class="label">{d.works.challengeLabel}</p></div>
      <p class="prose" style="font-size:var(--step-1);line-height:2.05"><T text={item.challenge} lang={lang} /></p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split" style="align-items:start">
      <div><p class="label">{d.works.approachLabel}</p></div>
      <p class="h-md"><T text={item.approach} lang={lang} /></p>
    </div>
  </section>

  <section class="sec invert" style="padding-block:clamp(5rem,14vh,9rem)">
    <div class="wrap split" style="align-items:start">
      <div><p class="label">{d.works.essenceLabel}</p></div>
      <blockquote class="essence"><T text={item.essence} lang={lang} /></blockquote>
    </div>
  </section>

  <nav class="case-nav" aria-label="cases">
    <a class="case-nav__item" href={localePath(lang, `/works/${prev.slug}`)}>
      <span class="meta">← {prev.no}</span>
      <span class="case-nav__title"><T text={prev.title} lang={lang} /></span>
    </a>
    <a class="case-nav__item" href={localePath(lang, `/works/${next.slug}`)}>
      <span class="meta">{next.no} →</span>
      <span class="case-nav__title"><T text={next.title} lang={lang} /></span>
    </a>
  </nav>

  <div class="wrap" style="padding-block:2.5rem 0">
    <a class="meta link" href={localePath(lang, '/works')}>{d.works.backToList}</a>
  </div>
</article>
