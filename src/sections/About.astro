---
import T from '../components/T.astro';
import { t, localePath, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const faces = ['kr', 'jp', 'tw'];
const creeds = [d.philosophy.vision, d.philosophy.mission, d.philosophy.values];
---
{/* ABOUT = 사상. 실체(대표 메시지·팀·会社概要)는 /company 로 분리했다.
    VISION → MISSION → VALUES 는 하나의 흐름이므로 괘선으로 끊지 않는다.
    셋의 제목은 크기·굵기·자간을 완전히 통일한다 — 위계가 생기면 「부속」처럼 읽힌다. */}
{creeds.map((c, i) => (
  <section class={i === 0 ? 'sec sec--flush sec--vision' : 'sec sec--creed'}>
    <div class="wrap">
      <div class="creed">
        <p class="label">{c.label}</p>
        {i === 0
          ? <h1 class="creed__head"><T text={c.head} lang={lang} /></h1>
          : <h2 class="creed__head"><T text={c.head} lang={lang} /></h2>}
        <p class="creed__en">{c.en}</p>
        <p class="creed__body"><T text={c.body} lang={lang} /></p>
      </div>

      {i === 0 && (
        <>
          {/* VISION 비주얼 — 위에서 내려다본 군상 위로 선 다섯 개가 지나간다.
              ------------------------------------------------------------
              구 버전은 AI 인물 사진 3장(한국·일본·대만 여성)이었다.
              모델 컷은 「우리가 이런 사람들과 일한다」로 읽히고, 인물이 AI 라
              표시 의무(R10)도 따라붙었다. 시점을 위로 올려 군상으로 바꾸니
              개인이 아니라 흐름이 보인다.

              ⚠ 흑백으로 굽는다. CSS filter: grayscale() 을 쓰지 않는다 —
                다른 효과와 겹치면 충돌하고, 브라우저마다 결과가 갈린다.
                컬러판은 public/img/vision-color.webp 에 남겨뒀다.
                되돌리려면 아래 src 를 vision-color.webp 로 바꾸기만 하면 된다.

              ⚠ 컬러판의 선 5색은 임의 배색이 아니었다.
                COMPANY 페이지 멤버 5명의 퍼스널 컬러다.
                  #F37021 DONGHYUN LEE  / #3F8F63 YONGJUN PARK
                  #2E6FB7 JEEHYUN YONG  / #C0417A HESTER LIN
                  #6B7043 SHISEI AOKI
                멤버가 바뀌면 컬러판도 다시 만들어야 한다. */}
          <figure class="vision-band">
            <img
              src="/img/vision.webp"
              width="1408" height="596"
              alt="" loading="lazy" decoding="async"
            />
          </figure>
          {/* AI 생성 표기 — 한국 AI기본법(2026-01-22 시행) 대응.
              이 이미지는 AI 로 생성했으므로 표기를 지우면 안 된다. */}
          <p class="vision-band__note">{d.philosophy.aiNote}</p>
        </>
      )}
    </div>
  </section>
))}

{/* WHY — 사명의 유래. 유일한 반전 화면으로 ABOUT 을 닫는다.
    기호는 글자가 아니라 마크라, 본문과 같은 수치면 작아 보인다. 제목의 약 2배로 세운다. */}
<section class="why" id="why">
  <div class="wrap">
    <div class="why__inner">
      <p class="label">{d.why.eyebrow}</p>
      <div class="whyglyph">
        <svg class="whyglyph__svg" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M34 4 L26 96 M70 4 L62 96 M6 32 L96 32 M4 66 L94 66" stroke="currentColor" stroke-width="12" fill="none" />
        </svg>
        <span class="whyglyph__x" aria-hidden="true">&times;</span>
        <svg class="whyglyph__svg" viewBox="0 0 160 92" aria-hidden="true">
          <path d="M80 46 C64 16, 24 16, 20 46 C24 76, 64 76, 80 46 C96 16, 136 16, 140 46 C136 76, 96 76, 80 46 Z"
                stroke="currentColor" stroke-width="11" fill="none" stroke-linejoin="round" />
        </svg>
      </div>
      {d.why.lines.map((block) => (
        <p class="why__lead">{block.map((l) => <span><T text={l} lang={lang} /></span>)}</p>
      ))}

      {/* ABOUT(사상) 다음은 COMPANY(그 사상을 가진 사람들). 읽는 순서지 영업이 아니다.
          CONTACT 로 닫지 않는 유일한 페이지 — WHY 가 이미 검정이라 CTA 섹션을 또 겹칠 수 없다. */}
      <p class="why__cta">
        {/* 바로 위가 「その意志を、名前に込めています。」로 끝나므로 그 이름을 그대로 버튼으로 쓴다.
            목적지가 문구에 없으므로 aria-label 로 보완한다. */}
        <a class="btn btn--on-dark" href={localePath(lang, '/company')} aria-label={d.nav.company}>
          <span>TAG EIGHT</span><span class="btn__arrow">→</span>
        </a>
      </p>
    </div>
  </div>
</section>
