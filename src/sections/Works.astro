---
import Sentences from '../components/Sentences.astro';
import T from '../components/T.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getCases } from '../data/cases';
import { t, localePath, type Lang } from '../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const list = getCases(lang);
---
{/* CAPABILITIES 와 같은 문법 — 사진 → 라벨 → 제목 → 리드.
    같은 이미지를 돌려쓰지 않는다. WORKS 전용으로 새로 만든 컷.
    ⚠️ 두 번 반려됐다.
       v154 정물(백지 인쇄물) → 「생동감 없다」
       v155 촬영 현장(카메라·조명) → 「영상 제작회사로 보인다」
       TAG EIGHT 는 제작사가 아니라 기획·실행·집행이다.
       현재: 도심 이벤트 집행 현장 + 자사 브랜딩 합성.
       사이니지는 AI 가 백지로 생성하고, 문자는 후반에 실제 로고·서체로 얹었다.
       AI 에게 글자를 그리게 하면 깨진다. */}
<figure class="capband capband--top">
  <img src="/img/works-band.webp"
       srcset="/img/works-band-sm.webp 1260w, /img/works-band.webp 2520w"
       sizes="100vw" width="2520" height="720"
       alt="" loading="eager" decoding="async" fetchpriority="high" />
</figure>

<section class="sec sec--flush page-head page-head--band">
  <div class="wrap">
    <p class="label">{d.works.eyebrow}</p>
    <h1 class="h-lg" style="margin-top:clamp(1.75rem,4vh,2.5rem)"><T text={d.works.head} lang={lang} /></h1>
    <p class="lead"><Sentences text={d.works.sub} lang={lang} /></p>

    {list.length === 0 ? (
      <div class="empty" style="margin-top:clamp(3rem,8vh,5rem)">{d.works.empty}</div>
    ) : (
      <div class="cases" data-layout="works-v162" style="margin-top:clamp(3rem,8vh,5rem)">
        {list.map((c) => (
          <a class="case-row" href={localePath(lang, `/works/${c.slug}`)}>
            <span class="num">{c.no}</span>
            <span class="case-main">
              {/* 분류를 제목 위로 올린다 — 시선이 번호 → 분류 → 제목 순으로 흐른다 */}
              <span class="case-cat">{c.category}</span>
              {/* 데스크톱은 1행 고정(nowrap). 모바일에서는 접히므로
                  BudouX <wbr> 는 그대로 태운다 — nowrap 이 걸리면 무시된다. */}
              <span class="case-row__title"><T text={c.title} lang={lang} /></span>
            </span>
            <span class="case-route">{c.route}</span>
          </a>
        ))}
      </div>
    )}
    {/* 46ch 는 CJK 에서 실제 글자 폭의 절반밖에 못 담아 2행으로 접혔다. 한 줄로 세운다 */}
    <p class="meta" style="margin-top:2.5rem">{d.works.confidential}</p>
  </div>
</section>

<ClosingCta lang={lang} />
