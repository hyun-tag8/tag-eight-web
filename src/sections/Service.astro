---
import Sentences from '../components/Sentences.astro';
import Arrow from '../components/Arrow.astro';
/**
 * CAPABILITIES — 아코디언.
 * 각 영역을 펼치면 그 영역으로 실제로 한 일(케이스)이 바로 나온다.
 * 서비스와 실적이 한 자리에서 연결되는 것이 이 구조의 목적.
 */
import T from '../components/T.astro';
import { getCases } from '../data/cases';
import { t, localePath, type Lang } from '../data/i18n';
import ClosingCta from '../components/ClosingCta.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
const keys = ['think', 'create', 'activate'];

/* 케이스 카테고리를 3영역에 매핑한다. 카테고리 표기를 바꾸지 않고 연결만 만든다. */
const CATS: Record<string, string[]> = {
  think:    ['メディア戦略', '検索導線最適化', '戦略設計',
             '미디어 전략', '검색 동선 최적화', '전략 설계',
             '媒體策略', '搜尋動線最佳化', '策略設計'],
  create:   ['クリエイティブ設計', 'コンテンツ制作', 'PPL・番組連動設計',
             '크리에이티브 설계', '콘텐츠 제작', 'PPL·프로그램 연동 설계',
             '創意設計', '內容製作', '置入・節目連動設計'],
  activate: ['クリエイターマーケティング', 'キャンペーン設計・実行',
             '크리에이터 마케팅', '캠페인 설계·실행',
             '創作者行銷', '活動設計・執行'],
};

const all = getCases(lang);
---
{/* 사진을 맨 위로. 이미지 → 라벨 → 제목 → 본문 → WE THINK 로 내려오면
    도입부와 3블록이 하나의 흐름이 된다. */}
<figure class="capband capband--top">
  <img src="/img/cap-band.webp"
       srcset="/img/cap-band-sm.webp 1100w, /img/cap-band.webp 2200w"
       sizes="100vw" width="2200" height="1015"
       alt="" loading="eager" decoding="async" fetchpriority="high" />
</figure>

<section class="sec sec--flush page-head page-head--band">
  <div class="wrap">
    <p class="label">{d.whatWeDo.eyebrow}</p>
    <h1 class="h-lg" style="margin-top:clamp(1.75rem,4vh,2.5rem)">
      {d.whatWeDo.head.map((l, i) => (
        <><span class="jp-line"><T text={l} lang={lang} /></span>{i < d.whatWeDo.head.length - 1 && <span class="vh"> </span>}</>
      ))}
    </h1>
    {/* 원고의 \n 은 유지하고, 그 안에서 문장 단위로 한 번 더 나눈다.
        Sentences 가 block 을 만드므로 <br> 은 쓰지 않는다 */}
    <p class="lead">
      {d.whatWeDo.body.split('\n').map((ln) => <Sentences text={ln} lang={lang} />)}
    </p>
  </div>
</section>

{/* 위에 밴드(이미지)가 있으므로 괘선까지 두면 구분이 두 번이 된다 */}
<section class="sec sec--flush">
  <div class="wrap cap">
    {d.whatWeDo.blocks.map((b, i) => {
      const key = keys[i];
      /* 영역마다 3 / 5 / 2 건으로 편차가 컸다. 2건으로 맞춰 세 블록의 무게를 같게 한다.
         더 보려면 WORKS 로 간다 — 여기는 「이 영역으로 무엇을 했는가」의 예시 자리다. */
      const related = all.filter((c) => CATS[key].includes(c.category)).slice(0, 2);
      return (
        <details class="cap__item" id={key} open={i === 0}>
          <summary class="cap__head">
            <span class="cap__titles">
              <span class="cap__en">{b.title}</span>
              <span class="cap__ja">{b.ja}</span>
              {/* 항목을 제목에 붙인다. 떨어져 있으면 제목이 「이것만 한다」로 읽힌다 */}
              <span class="cap__items">{b.items.map((it) => <span>{it}</span>)}</span>
            </span>
            <span class="cap__chev" aria-hidden="true"></span>
          </summary>

          <div class="cap__body">
            <p class="cap__lead"><Sentences text={b.lead} lang={lang} /></p>

            {related.length > 0 && (
              <div class="cap__cases">
                {related.map((c, ci) => (
                  <div class="capcase">
                    {/* 사진 삭제(2026-08-25) — 도시 사진 3장을 케이스가 돌려쓰던 구조라
                        「그 케이스의 사진」이 못 됐다. 케이스 상세와 같은 기준 */}
                    <div class="capcase__body">
                      {/* 번호는 WORKS 목록의 것이라 여기서는 맥락이 없다. 카테고리와 루트만 남긴다 */}
                      <p class="capcase__meta"><span class="capcase__cat">{c.category}</span><span class="capcase__route">　—　{c.route}</span></p>
                      <h3 class="capcase__title"><T text={c.title} lang={lang} /></h3>
                      <p class="capcase__essence"><Sentences text={c.essence} lang={lang} /></p>
                      {/* 카드 전체를 반전시키면 시선이 사진으로 가지 않는다.
                          홈 WORKS 와 같은 버튼 하나만 반전시킨다 */}
                      <a class="btn capcase__btn" href={localePath(lang, `/works/${c.slug}`)}>
                        <span>{d.common.viewMore}</span><span class="btn__slot"><Arrow variant="chev" cls="btn__arrow" /></span>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </details>
      );
    })}
  </div>
</section>

<ClosingCta lang={lang} />
