---
import Sentences from '../components/Sentences.astro';
import Arrow from '../components/Arrow.astro';
import T from '../components/T.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getCases } from '../data/cases';
import { company } from '../data/company';
import { t, localePath, type Lang } from '../data/i18n';
import { getHomeStream, fmtDate, CAT_SLUG } from '../lib/insight';
import NewBadge from '../components/NewBadge.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t[lang];
/* 홈에 노출할 4건. 순서·구성을 여기서만 바꾸면 된다.
   3개 방향(台湾→韓国 / 日本→韓国 / 日本→台湾)이 모두 보이도록 07 을 포함한다.
   전부 「→韓国」 이면 대만이 도착 시장으로 한 번도 나오지 않는다. */
const FEATURED = ['film-festival-buzz', 'search-first-content', 'from-interest-to-action', 'region-as-story'];
const all = getCases(lang);
const cases = FEATURED.map((sl) => all.find((c) => c.slug === sl)).filter(Boolean) as typeof all;

/* 밴드 설명문에서 흰색으로 띄울 낱말. 회사명과 업종명 두 개.
   split 에 캡처 그룹을 쓰면 구분자도 배열에 남는다. */
const HL = /(TAG EIGHT|Creative Agency|創意代理商)/;

const panels = [
  { key: 'seoul',  label: 'KOREA',  city: 'SEOUL',  tz: 'Asia/Seoul',  zone: 'KST' },
  { key: 'tokyo',  label: 'JAPAN',  city: 'TOKYO',  tz: 'Asia/Tokyo',  zone: 'JST' },
  { key: 'taipei', label: 'TAIWAN', city: 'TAIPEI', tz: 'Asia/Taipei', zone: 'CST' },
];
const svcImg = ['think', 'create', 'activate'];

/* 홈에 띄울 3건 — 분류마다 최신 1건씩.
   「최신 3건」으로 뽑으면 한국 글만 3개 뜨는 날이 생기고,
   그날은 대만을 다룬다는 신호가 사라진다. */
const picks = await getHomeStream(lang, 3);
---

<!-- 1. 히어로 — 3분할 세로 패널. 각 도시의 타임랩스 위에 아이덴티티가 서서히 떠오른다.
     사람은 흐르고, 동상·횡단보도·바닥 글자는 움직이지 않는다. -->
<section class="vhero">
  <div class="vhero__panels">
    {panels.map((p) => (
      <figure class={`vpanel vpanel--${p.key}`} data-tz={p.tz}>
        {/* 모바일·저사양·모션최소화 환경에서는 CSS 로 감추고 포스터만 남는다 */}
        <video
          class="vpanel__video"
          autoplay muted loop playsinline
          preload="metadata"
          poster={`/video/${p.key}-poster.webp`}
        >
          <source src={`/video/${p.key}.mp4`} type="video/mp4" />
        </video>
        <div class="vpanel__veil"></div>
        <figcaption class="vpanel__foot">
          <span class="vpanel__label">{p.label}</span>
          <span class="vpanel__time" data-clock>--:--<span class="vpanel__sec">:--</span></span>
          <span class="vpanel__zone">{p.city}　{p.zone}</span>
        </figcaption>
      </figure>
    ))}

    {/* 아이덴티티 — 로드 직후 서서히 떠오른다 */}
    <div class="vhero__overlay">
      <h1 class="vhero__id">
        <span class="vhero__line vhero__catch">
          <span class="vhero__part">{d.hero.catch[0]}</span>{' '}
          <span class="vhero__part">{d.hero.catch[1]}</span>
        </span>
        <span class="vh"> — </span>
        <span class="vhero__line vhero__name">{company.legalNameEn}</span>
      </h1>
    </div>
  </div>

  {/* 히어로 하단 검정 밴드 — 왼쪽 선언 / 오른쪽 설명 */}
  <div class="vhero__band">
    <div class="wrap vband">
      <div class="vband__left">
        <p class="vband__lead">
          {d.hero.lead.map((l) => <span class="jp-line"><T text={l} lang={lang} /></span>)}
        </p>
        <p class="vband__statement"><T text={d.hero.statement[0]} lang={lang} /></p>
      </div>
      <p class="vband__body">
        {/* 「누구인가」와 「무엇인가」 두 낱말만 흰색으로 띄운다.
            문장 처음과 끝을 잡아 괄호처럼 작동한다 */}
        {d.hero.body.split('\n').map((l) => (
          <span class="jp-line">
            {l.split(HL).filter(Boolean).map((part) =>
              HL.test(part)
                ? <span class="vband__brand">{part}</span>
                : <T text={part} lang={lang} />
            )}
          </span>
        ))}
      </p>
    </div>
  </div>
</section>

<!-- 2. INSIGHT — 「지금 살아 있는 회사」를 첫 스크롤에서 보여준다.
     WORKS 아래로 내리면 대부분 도달하지 못한다.
     분류마다 1건씩이라, 어느 날 봐도 韓国·台湾·お知らせ 세 축이 함께 선다. -->
{picks.length > 0 && (
  <section class="sec" data-layout="home-insight-v179">
    <div class="wrap">
      <p class="seclabel">{d.journal.homeLabel}</p>
      <h2 class="h-lg" style="margin-top:clamp(1.75rem,4vh,2.5rem)"><T text={d.journal.homeHead} lang={lang} /></h2>

      {/* 홈도 INSIGHT 페이지와 같은 3열. 다만 분류마다 최신 3건까지 세로로 쌓는다.
          1건만 세우면 「가끔 쓰는 곳」으로 보이고, 쌓여 있으면 「계속 쓰는 곳」이 된다.
          ⚠ 비어 있는 분류도 열을 남긴다 — 사라지면 그 시장은 안 한다로 읽힌다 */}
      <div class="hins srows" style="margin-top:clamp(2rem,4.5vh,2.75rem)">
        {picks.map(({ cat, posts }) => (
          <div class="srow">
            <p class="srow__head">
              <a class="srow__link" href={localePath(lang, `/insight/${CAT_SLUG[cat as 'korea' | 'taiwan' | 'notice']}`)}>
                <span>{d.journal.cat[cat as 'korea' | 'taiwan' | 'notice']}</span><Arrow variant="chev" cls="srow__arw" />
              </a>
            </p>
            {posts.length === 0 ? (
              <p class="srow__empty">{d.journal.catEmpty}</p>
            ) : (
              <div class="slist">
                {posts.map((post) => (
                  <a class="sitem" href={localePath(lang, `/insight/${post.data.postId}`)}>
                    <span class="sitem__date">{fmtDate(post.data.date)}</span>
                    <span class="sitem__title"><T text={post.data.title} lang={lang} /></span>
                    <NewBadge date={post.data.date} />
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <p style="margin-top:clamp(2rem,4.5vh,2.75rem)">
        <a class="btn" href={localePath(lang, '/insight')}>
          <span>{d.nav.insight}</span><span class="btn__slot"><Arrow variant="chev" cls="btn__arrow" /></span>
        </a>
      </p>
    </div>
  </section>
)}

<!-- 3. WORKS — 증거가 약속보다 먼저 온다 -->
<section class="sec">
  <div class="wrap">
    <p class="seclabel">{d.works.eyebrow}</p>
    <h2 class="h-lg" style="margin-top:clamp(1.75rem,4vh,2.5rem)"><T text={d.works.head} lang={lang} /></h2>
    <p class="secsub"><Sentences text={d.works.sub} lang={lang} /></p>

    {/* 세로 1열 리스트 — 번호 · 사진 · (분류 / 제목).
        가로 2열 카드는 설명을 지운 뒤 비어 보였다. 사진이 들어가면서 무게가 생기고,
        분류와 제목이 위아래로 붙어 한 덩어리로 읽힌다. */}
    {cases.length === 0 ? (
      <div class="empty" style="margin-top:3rem">{d.works.empty}</div>
    ) : (
      <div class="wgrid">
        {cases.map((c, i) => (
          <a class="wcard rise" href={localePath(lang, `/works/${c.slug}`)}>
            {/* 번호는 배경 오브제. 카드마다 크게 앉혀 4분할에 리듬을 만든다 */}
            <span class="wcard__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {/* 제목이 먼저 읽히고 분류는 그 뒤에 확인한다 — 케이스는 제목이 흥미를 만든다 */}
            <h3 class="wcard__title"><T text={c.title} lang={lang} /></h3>
            <p class="wcard__meta">
              <span class="wcard__cat">{c.category}</span>
              <span class="wcard__route">{c.route}</span>
            </p>
          </a>
        ))}
      </div>
    )}
    <p style="margin-top:clamp(2.5rem,6vh,3.5rem)"><a class="btn" href={localePath(lang, '/works')}><span>{d.nav.works}</span><span class="btn__slot"><Arrow variant="chev" cls="btn__arrow" /></span></a></p>
  </div>
</section>

<!-- 3. CLIENTS — 실명 대신 영역으로 -->
<section class="sec invert">
  <div class="wrap">
    <p class="seclabel">{d.sectors.eyebrow}</p>
    <h2 class="h-lg" style="margin-top:clamp(1.75rem,4vh,2.5rem)"><T text={d.sectors.head} lang={lang} /></h2>
    <p class="secsub sector__lead">
      {/* 정규식 분할을 Sentences 로 교체(2026-08-25) — 소수점·닫는 괄호·인용 안 물음표 함정 */}
      <Sentences text={d.sectors.sub} lang={lang} cls="jp-line" />
    </p>

    <div class="sectors">
      {d.sectors.items.map((s) => (
        <article class="sector rise">
          <p class="sector__meta">
            <span class="num">{s.no}</span>
            <span class="sector__en">{s.en}</span>
          </p>
          <h3 class="sector__ja"><T text={s.ja} lang={lang} /></h3>
          <p class="sector__body"><T text={s.body} lang={lang} /></p>
        </article>
      ))}
    </div>
    {/* 한 줄로 흘린다. 문장마다 끊으면 각주 두 개가 나란히 선 것처럼 보여
        「본문」의 무게가 붙는다. 각주는 한 덩어리로 가볍게 지나가는 게 맞다.
        폭이 좁아지면 자연스럽게 접히되, 끊기는 위치는 T(BudouX)가 잡는다. */}
    <p class="sector__note"><T text={d.sectors.note} lang={lang} /></p>
  </div>
</section>

<!-- 4. SERVICE -->
<section class="sec sec--flush" style="padding-block:clamp(4rem,11vh,7.5rem)">
  <div class="wrap">
    <p class="seclabel">{d.whatWeDo.eyebrow}</p>
    {/* 구두점 단위로 쪼개 각 동사 사이에 숨을 준다 */}
    <h2 class="h-lg h-lg--beats" style="margin-top:clamp(1.75rem,4vh,2.5rem)">
      {d.whatWeDo.headHome.split(/(?<=[。.])/).filter(Boolean).map((bt) => (
        <span class="beat"><T text={bt} lang={lang} /></span>
      ))}
    </h2>
    {/* 원고의 개행은 유지하고, 그 안에서 문장 단위로 한 번 더 나눈다 */}
    <p class="secsub">
      {d.whatWeDo.sub.split('\n').map((ln) => <Sentences text={ln} lang={lang} />)}
    </p>
  </div>

  {/* 홈은 요약 — 3열로 나란히. 좌우 교대 배치는 SERVICE 페이지가 맡는다.
      블록을 눌러 해당 위치로 이동한다 */}
  <div class="wrap">
    <div class="svc-grid">
      {d.whatWeDo.blocks.map((b, i) => (
        <a class="svc-brief rise" href={localePath(lang, `/capabilities#${svcImg[i]}`)} aria-label={`${b.no} ${b.title}`}>
          {/* 기본은 정지 이미지. 호버할 때만 영상이 붙어 재생된다.
              영상 첫 프레임이 이 사진과 같아서 전환에 튐이 없다.
              터치 기기에는 아예 로드하지 않는다 — 호버가 없으니 낭비다. */}
          <figure class="svc-brief__fig tone" data-clip={`/video/work-${svcImg[i]}.mp4`}>
            {/* 표시폭은 모바일·데스크톱 모두 약 350px. 700w 판 하나로 2x 까지 커버된다 */}
            <img
              src={`/img/work-${svcImg[i]}-sm.webp`}
              width="700" height="467"
              alt="" loading="lazy" decoding="async"
            />
          </figure>
          <p class="svc-brief__meta">
            <span class="num">{b.no}</span>
            <span class="svc-brief__title">{b.title}</span>
          </p>
          {/* 영문만으로는 무엇을 하는지 알 수 없다. CAPABILITIES 와 같은 위계로 일본어를 세운다 */}
          <p class="svc-brief__ja"><T text={b.ja} lang={lang} /></p>
          <p class="svc-brief__lead"><T text={b.lead} lang={lang} /></p>
          {/* 실제 제공 업무 — 「무엇을 맡길 수 있는가」에 답하는 유일한 줄 */}
          {/* 슬래시 나열은 줄바꿈이 지저분해진다. 세로 목록으로 세운다 */}
          {/* 홈은 요약 — 3개. 전체 4개는 CAPABILITIES 가 맡는다 */}
          <ul class="svc-brief__items">{b.itemsHome.map((it) => <li>{it}</li>)}</ul>
        </a>
      ))}
    </div>

    <p style="margin-top:clamp(2.5rem,6vh,4rem)">
      <a class="btn" href={localePath(lang, '/capabilities')}><span>{d.nav.service}</span><span class="btn__slot"><Arrow variant="chev" cls="btn__arrow" /></span></a>
    </p>
  </div>
</section>

<ClosingCta lang={lang} />

<script>
  /* CAPABILITIES 카드 — 호버 시에만 영상을 붙인다.
     · 마우스가 있는 기기에서만 동작 (모바일은 다운로드조차 하지 않는다)
     · 모션 최소화 설정이면 비활성
     · 영상은 첫 호버 때 한 번만 생성해 재사용한다 */
  (() => {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!canHover || reduced) return;

    document.querySelectorAll<HTMLElement>('.svc-brief__fig[data-clip]').forEach((fig) => {
      let video: HTMLVideoElement | null = null;

      const start = () => {
        if (!video) {
          video = document.createElement('video');
          video.src = fig.dataset.clip!;
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.preload = 'none';
          video.className = 'svc-brief__clip';
          fig.appendChild(video);
        }
        video.currentTime = 0;
        video.play().catch(() => {});
        fig.classList.add('is-playing');
      };

      const stop = () => {
        fig.classList.remove('is-playing');
        video?.pause();
      };

      const card = fig.closest('.svc-brief')!;
      card.addEventListener('mouseenter', start);
      card.addEventListener('mouseleave', stop);
      card.addEventListener('focusin', start);
      card.addEventListener('focusout', stop);
    });
  })();


  // 현지 시각 — 1초마다 갱신. 세 도시가 같은 초를 함께 새긴다.
  const panelEls = document.querySelectorAll<HTMLElement>('.vpanel');
  const fmt = new Map<string, Intl.DateTimeFormat>();
  panelEls.forEach((p) => {
    const tz = p.dataset.tz!;
    fmt.set(tz, new Intl.DateTimeFormat('en-GB', {
      timeZone: tz, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
    }));
  });
  const tick = () => {
    const now = new Date();
    panelEls.forEach((p) => {
      const el = p.querySelector('[data-clock]');
      if (!el) return;
      const parts = fmt.get(p.dataset.tz!)!.formatToParts(now);
      const g = (t: string) => parts.find((x) => x.type === t)?.value ?? '--';
      el.innerHTML = `${g('hour')}:${g('minute')}<span class="vpanel__sec">:${g('second')}</span>`;
    });
  };
  tick();
  setInterval(tick, 1000);

  const io = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.rise').forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${Math.min(i % 6, 5) * 70}ms`;
    io.observe(el);
  });
</script>
