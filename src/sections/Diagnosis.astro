---
/**
 * 現地実測診断 — 商品ページ (ja 전용).
 *
 * 케이스 상세(CaseDetail.astro)와 같은 문법으로 짠다 — case-head / caserows / postcta / ClosingCta.
 * 새 CSS 를 만들지 않는다. 稟議에 붙이는 페이지라 「읽는 순서 = 계약이 진행되는 순서」로 쌓는다:
 *   わかること → 納品物 → 進め方 → 実績 → お約束 → FAQ → 申込
 * 수치는 diagnosis.ts 에서만 온다(자사 집행 실측). 여기서 숫자를 타이핑하지 않는다.
 */
import T from '../components/T.astro';
import Sentences from '../components/Sentences.astro';
import Arrow from '../components/Arrow.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { localePath, type Lang } from '../data/i18n';
import { diagnosis as g, type DiagRow } from '../data/diagnosis';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = g.sections;

const groups: { key: string; label: string; rows: readonly DiagRow[] }[] = [
  { key: 'know', label: s.know.label, rows: s.know.rows },
  { key: 'deliver', label: s.deliver.label, rows: s.deliver.rows },
  { key: 'process', label: s.process.label, rows: s.process.rows },
];
---
<article data-layout="diagnosis-v1">
  <header class="case-head">
    <div class="wrap">
      <p class="case-head__no">{g.head.label}</p>
      <p class="case-head__meta">
        <span class="case-head__cat">{g.head.product}</span>
        <span class="case-head__sep" aria-hidden="true">／</span>
        <span class="case-head__route">{g.head.scope}</span>
        <span class="case-head__sep" aria-hidden="true">／</span>
        <span class="case-head__route">{g.head.term}</span>
        {g.head.price && (
          <>
            <span class="case-head__sep" aria-hidden="true">／</span>
            <span class="case-head__route">{g.head.price}</span>
          </>
        )}
      </p>
      <h1 class="case-head__title"><T text={g.head.title} lang={lang} /></h1>
    </div>
  </header>

  {/* 도입 — 케이스의 課題 행과 같은 자리. 라벨 없이 문장만 */}
  <section class="sec sec--flush caserows">
    <div class="wrap">
      <div class="caserow">
        <p class="caserow__label"></p>
        <p class="caserow__text"><Sentences text={g.intro} lang={lang} /></p>
      </div>

      {groups.map((grp) => (
        <>
          <div class="caserow">
            <p class="caserow__label">{grp.label}</p>
            <p class="caserow__text"></p>
          </div>
          {grp.rows.map((r) => (
            <div class="caserow">
              <p class="caserow__label">{r.label}</p>
              <p class="caserow__text"><Sentences text={r.text} lang={lang} /></p>
            </div>
          ))}
        </>
      ))}

      {/* 実績 — 마지막에 本質 문법으로 한 줄 */}
      <div class="caserow">
        <p class="caserow__label">{s.proof.label}</p>
        <p class="caserow__text"></p>
      </div>
      {s.proof.rows.map((r) => (
        <div class="caserow">
          <p class="caserow__label">{r.label}</p>
          <p class="caserow__text"><Sentences text={r.text} lang={lang} /></p>
        </div>
      ))}
      <div class="caserow caserow--essence">
        <p class="caserow__label"></p>
        <blockquote class="essence"><Sentences text={s.proof.essence} lang={lang} /></blockquote>
      </div>

      <div class="caserow">
        <p class="caserow__label">{s.promise.label}</p>
        <p class="caserow__text"></p>
      </div>
      {s.promise.rows.map((r) => (
        <div class="caserow">
          <p class="caserow__label">{r.label}</p>
          <p class="caserow__text"><Sentences text={r.text} lang={lang} /></p>
        </div>
      ))}

      <div class="caserow">
        <p class="caserow__label">{s.faq.label}</p>
        <p class="caserow__text"></p>
      </div>
      {s.faq.rows.map((r) => (
        <div class="caserow">
          <p class="caserow__label">{r.label}</p>
          <p class="caserow__text"><Sentences text={r.text} lang={lang} /></p>
        </div>
      ))}
    </div>
  </section>

  {/* 申込 — 기사 하단 CTA 와 같은 문법. ?s=diagnosis 로 문의 폼을 미리 채운다 */}
  <section class="sec postcta">
    <div class="wrap">
      <p class="postcta__head"><T text={g.cta.head} lang={lang} /></p>
      <p class="postcta__body"><T text={g.cta.body} lang={lang} /></p>
      <div class="postcta__acts">
        <a class="ulink" href={`${localePath(lang, '/contact')}?s=diagnosis`}>
          <span>{g.cta.btn}</span><Arrow variant="chev" cls="ulink__arw" />
        </a>
        <a class="ulink" href={localePath(lang, '/insight/korea')}>
          <span>{g.cta.readInsight}</span><Arrow variant="chev" cls="ulink__arw" />
        </a>
      </div>
    </div>
  </section>

  <ClosingCta lang={lang} />
</article>
