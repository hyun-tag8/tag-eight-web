---
/*
 * 404 — 存在しないページ
 *
 * ⚠️ 이 파일이 없으면 Cloudflare Pages 는 알 수 없는 모든 URL 에
 *    홈의 HTML 을 200 으로 돌려준다(소프트 404).
 *    이 사이트의 목적이 「검색·AI 에 읽히는 상태」이므로 치명적이다.
 *    - Search Console 에 색인 오류로 잡힌다
 *    - 존재하지 않는 경로가 홈의 복제본으로 무한 생성된다
 *    (2026-08-20 배포 검수에서 발견)
 *
 * Astro 가 dist/404.html 을 만들면 Cloudflare Pages 가
 * 자동으로 이걸 404 상태 코드와 함께 돌려준다.
 *
 * 3개 언어 공통 1장이다. 방문자가 어느 언어에서 왔는지 알 수 없으므로
 * 일본어(기본)를 본문으로 두고, 링크는 3개 언어 홈을 모두 노출한다.
 */
import Base from '../layouts/Base.astro';

const lang = 'ja' as const;
---

<Base
  lang={lang}
  title="ページが見つかりません｜TAG EIGHT"
  description="お探しのページは移動または削除された可能性があります。"
  path="/404"
  noindex={true}
>
  <section class="sec sec--flush page-head">
    <div class="wrap">
      <p class="label">404 — NOT FOUND</p>

      <h1 class="h-lg" style="margin-top:1.5rem">
        お探しのページが<wbr />見つかりません。
      </h1>

      <p class="lead">
        ページが移動または削除された可能性があります。<wbr />
        下のリンクからお進みください。
      </p>

      <nav class="nf__links" aria-label="サイト内リンク">
        <a href="/">日本語トップ</a>
        <a href="/ko">한국어 홈</a>
        <a href="/zh-tw">繁體中文首頁</a>
        <a href="/works">WORKS</a>
        <a href="/contact">CONTACT</a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf__links {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
  }

  .nf__links a {
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15rem;
    transition: opacity 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nf__links a:hover {
    opacity: 0.55;
  }
</style>
