---
import Base from '../../layouts/Base.astro';
import Company from '../../sections/Company.astro';
import { t, type Lang } from '../../data/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'ko' } }, { params: { lang: 'zh-tw' } }];
}

const lang = Astro.params.lang as Lang;
const m = t[lang].meta.company;
---
<Base lang={lang} title={m.title} description={m.description} path="/company">
  <Company lang={lang} />
</Base>
