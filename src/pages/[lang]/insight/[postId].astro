---
import Base from '../../../layouts/Base.astro';
import Post from '../../../sections/Post.astro';
import { getPosts, isReservedSlug, langsForPost } from '../../../lib/insight';
import { LANGS, type Lang } from '../../../data/i18n';

// ja 는 루트 라우트가 담당. 번역이 있는 언어만 생성한다.
export async function getStaticPaths() {
  const out = [];
  for (const lang of LANGS.filter((l) => l !== 'ja')) {
    for (const post of await getPosts(lang)) {
      // korea / taiwan / notice 는 분류 목록 URL 이다 — 충돌을 막는다
      if (isReservedSlug(post.data.postId)) continue;
      out.push({ params: { lang, postId: post.data.postId }, props: { post } });
    }
  }
  return out;
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
// 번역이 있는 언어만 hreflang·언어 스위처에 싣는다
const langs = await langsForPost(post.data.postId);
---
<Base lang={lang} title={`${post.data.title}｜INSIGHT｜TAG EIGHT`}
      description={post.data.excerpt ?? post.data.title} path={`/insight/${post.data.postId}`}
      image={post.data.cover} langs={langs}>
  <Post lang={lang} post={post} />
</Base>
