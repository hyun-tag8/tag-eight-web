---
/* 現地実測診断 — ja 전용 라우트. ko / zh-TW 는 만들지 않는다(diagnosis.ts 참조).
   푸터 언어 스위치는 langsFor('/diagnosis') 가 ['ja'] 를 돌려 다른 언어를 링크하지 않는다. */
import Base from '../layouts/Base.astro';
import Diagnosis from '../sections/Diagnosis.astro';
import { diagnosis, DIAG_PATH } from '../data/diagnosis';
const lang = 'ja' as const;
---
<Base lang={lang} title={diagnosis.meta.title} description={diagnosis.meta.description} path={DIAG_PATH}>
  <Diagnosis lang={lang} />
</Base>
