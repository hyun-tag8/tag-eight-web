import Journal from '../sections/Journal.astro';
import { t } from '../data/i18n';
const lang = 'ja' as const;
const m = t[lang].meta.insight;
---
<Base lang={lang} title={m.title} description={m.description} path="/insight">
  <Journal lang={lang} />
</Base>
