---
import Base from '../layouts/Base.astro';
import Service from '../sections/Service.astro';
import { t } from '../data/i18n';
const lang = 'ja' as const;
const m = t[lang].meta.service;
---
<Base lang={lang} title={m.title} description={m.description} path="/capabilities">
  <Service lang={lang} />
</Base>
