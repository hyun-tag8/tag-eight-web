---
import Base from '../../layouts/Base.astro';
import Post from '../../sections/Post.astro';
import { getPosts, isReservedSlug, langsForPost } from '../../lib/insight';

export async function getStaticPaths() {
  const posts = await getPosts('ja');
  // korea / taiwan / notice 는 분류 목록 URL 이다. 같은 이름의 기사는 라우트를 만들지 않는다
  return posts
    .filter((post) => !isReservedSlug(post.data.postId))
    .map((post) => ({ params: { postId: post.data.postId }, props: { post } }));
}

const { post } = Astro.props;
const lang = 'ja' as const;
// 번역이 있는 언어만 hreflang·언어 스위처에 싣는다 — 없는 언어를 실으면 404 를 가리킨다
const langs = await langsForPost(post.data.postId);
---
<Base lang={lang} title={`${post.data.title}｜INSIGHT｜TAG EIGHT`}
      description={post.data.excerpt ?? post.data.title} path={`/insight/${post.data.postId}`}
      image={post.data.cover} langs={langs}>
  <Post lang={lang} post={post} />
</Base>
