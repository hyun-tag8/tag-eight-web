{
  "$schema": "https://json.schemastore.org/tsconfig",

  // ⚠ 원래는 "extends": "astro/tsconfigs/strict" 였다.
  //   2026-08-24, 맥 로컬에서 이 참조가 풀리지 않아 빌드가 계속 깨졌다.
  //     [rolldown:vite-resolve] Tsconfig not found astro/tsconfigs/strict
  //   npm ci 로 lock 그대로 설치해도 재현됐다. 버전 문제가 아니라
  //   패키지 exports 해석 단계의 문제라 환경에 따라 갈린다.
  //
  //   astro/tsconfigs/base.json + strict.json 의 내용을 그대로 펼쳐 넣어
  //   외부 참조를 없앴다. 동작은 동일하고 더 이상 깨질 수 없다.
  //   Astro 가 프리셋을 바꾸면 여기도 손으로 맞춰야 한다.

  "compilerOptions": {
    // 최신 ESM 기능(top-level await 등)을 쓴다
    "target": "ESNext",
    "module": "ESNext",
    // npm 패키지 import 를 위해 확장자 없는 해석을 허용
    "moduleResolution": "Bundler",
    // .ts(x) 확장자를 붙여서 import 하는 것을 허용
    "allowImportingTsExtensions": true,
    // JSON import 허용
    "resolveJsonModule": true,
    // 타입 전용 import 를 강제해 번들 문제를 예방
    "verbatimModuleSyntax": true,
    // 파일 하나만으로 트랜스파일이 가능하도록 보장
    "isolatedModules": true,
    // Astro 는 TS 를 직접 실행한다. 출력 파일이 필요 없다
    "noEmit": true,
    // 같은 파일을 대소문자 다르게 import 하면 오류
    "forceConsistentCasingInFileNames": true,
    // CJS 모듈을 ESM 에서 제대로 쓰기 위함
    "esModuleInterop": true,
    // 라이브러리·.d.ts 타입 검사 생략
    "skipLibCheck": true,
    // .js 파일 import 허용
    "allowJs": true,
    // .astro 는 내부적으로 JSX 로 다뤄진다
    "jsx": "preserve",

    // ↓ strict.json 이 더하던 것
    "strict": true
  },

  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro"],
  "exclude": ["dist"]
}
